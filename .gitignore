# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.runtime/
*.egg-info/
dist/

# --- Test and coverage caches -------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/
*.profraw
*.profdata

# --- Local tool and assistant state (never commit scratch space) --------------
.claude/
.crush/
.remember/
.superpowers/
.idea/

# --- Secrets & Vaults ---------------------------------------------------------
.env
.env.*
!.env.example
.vault/
.vaults/
vault/
vaults/
*.vault
*.vaults
.keychain_backup/

# --- Rust build artifacts (prevent large binary commits) ----------------------
target/
**/target/
*.rlib

# --- Databases ----------------------------------------------------------------
*.db
*.sqlite

# --- Build and benchmark results ----------------------------------------------
Agents/benchmark/results/
Main/Essentials/

# --- Docs: keep curated docs; scratch only under docs/superpowers -------------
docs/*
!docs/MemoryAllocators.md
!docs/Molten.md
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/
!docs/superpowers/plans/

# --- Nested git worktree (branch worktree/websearch); no trailing slash so ----
# --- the symlink itself is ignored, not just a materialized directory. --------
/WebSearch

# --- Jupyter scratch ----------------------------------------------------------
notebooks/.ipynb_checkpoints/
