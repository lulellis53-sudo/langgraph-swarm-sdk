name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: read

jobs:
  test:
    name: "Gate: tests"
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      - uses: ./.github/actions/setup-python
      - name: Run tests
        run: uv run pytest Agents/benchmark/tests -q

  build:
    name: Build distributions
    runs-on: ubuntu-latest
    needs: test
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      - uses: ./.github/actions/setup-python
        with:
          sync: "false"
      - name: Build distributions
        run: uv build
      - name: Check metadata freshness
        run: |
          # Fail if the tag version does not match pyproject version
          TAG="${GITHUB_REF_NAME#v}"
          PROJ="$(grep -m1 '^version' pyproject.toml | sed 's/version = "\(.*\)"/\1/')"
          if [ "$TAG" != "$PROJ" ]; then
            echo "Tag v$TAG does not match pyproject version $PROJ" >&2
            exit 1
          fi
      - uses: actions/upload-artifact@v7
        with:
          name: dist
          path: dist/

  publish:
    name: Publish to PyPI
    runs-on: ubuntu-latest
    needs: build
    environment: pypi
    timeout-minutes: 10
    permissions:
      # Required for PyPI Trusted Publishing (OIDC)
      id-token: write
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/
      - name: Publish
        uses: pypa/gh-action-pypi-publish@release/v1
