# LLM provider. create_agent accepts "provider:model" strings, so the
# provider integration stays swappable (openai, anthropic, mistral, ...).
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=

# OpenAI-compatible provider keys and optional base-URL overrides.
# SAMBANOVA_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=
# MIMO_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# NVIDIA_API_KEY=
# OLLAMA_CLOUD_API_KEY=
# LLM7_API_KEY=

# LangSmith observability. With LANGSMITH_TRACING=true every LangGraph node,
# LLM call, and tool invocation is traced automatically.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=langswarm
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Long-term memory (mem0 Platform). Get a key at https://app.mem0.ai.
MEM0_API_KEY=m0-...

# Langswarm settings (LANGSWARM_ prefix).
LANGSWARM_DEFAULT_MODEL=openai:gpt-4o
LANGSWARM_CONFIG_PATH=config/swarm.yaml
LANGSWARM_CHECKPOINTER=memory
LANGSWARM_THREAD_ID=cli-thread
LANGSWARM_DATA_PATH=data/sample.csv
LANGSWARM_ARTIFACTS_PATH=data/artifacts

# RAG. faiss runs fully local (default); pgvector needs the postgres extra
# plus a Postgres instance with the pgvector extension.
LANGSWARM_VECTOR_BACKEND=faiss
LANGSWARM_FAISS_PATH=data/faiss_index
LANGSWARM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LANGSWARM_EMBEDDING_BACKEND=auto
LANGSWARM_QWEN_ONNX_PATH=models/qwen3-embedding-0.6b-int4
LANGSWARM_QWEN_ONNX_FILE=model_int4.onnx
# LANGSWARM_PGVECTOR_COLLECTION=langswarm
# LANGSWARM_PRISMA_DB_URL=postgresql://user:password@host:5432/db?sslmode=require
# LANGSWARM_SUPABASE_DB_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Redis checkpointer (redis extra; Redis 8.x includes the JSON and Search
# modules that langgraph-checkpoint-redis needs).
# LANGSWARM_REDIS_URL=redis://localhost:6379

# Live web and MCP tools (install the websearch extra as needed).
# TAVILY_API_KEY=
# JINA_API_KEY=
# APIFY_TOKEN=
# LANGSWARM_APIFY_ACTOR=apify/google-search-scraper
# LANGSWARM_DEEPWIKI_BASE=https://deepwiki.com
# LANGSWARM_ALGORITHMS_REPO=TheAlgorithms/Python
# LANGSWARM_MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Serving.
LANGSWARM_API_HOST=127.0.0.1
LANGSWARM_API_PORT=8000
LANGSWARM_GRPC_PORT=50051

# Logging.
LANGSWARM_LOG_LEVEL=INFO
# LANGSWARM_LOG_JSON=true
