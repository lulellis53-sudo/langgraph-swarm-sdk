{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.languageServer": "None",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.showHoverGoToLinks": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "editor.inlayHints.enabled": "on",
  "python.pyrefly.disableLanguageServices": true,
  "python.pyrefly.disableTypeErrors": false,
  "python.pyrefly.typeCheckingMode": "default",
  "python.pyrefly.diagnosticMode": "workspace",
  "python.pyrefly.configPath": "${workspaceFolder}/pyproject.toml",
  "python.pyrefly.syncNotebooks": true,
  "python.pyrefly.streamDiagnostics": true,
  "pyrefly.pyreflyExecutable": "from-environment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    },
    "editor.defaultFoldingRangeProvider": "charliermarsh.ruff"
  },
  "ruff.enable": true,
  "ruff.nativeServer": "on",
  "ruff.configuration": "pyproject.toml",
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.interpreter": [
    "${workspaceFolder}/.venv/bin/python"
  ],
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ty.importStrategy": "fromEnvironment",
  "ty.interpreter": "${workspaceFolder}/.venv/bin/python",
  "ty.diagnosticMode": "workspace",
  "ty.experimental.useUv": "on",
  "ty.disableLanguageServices": true,
  "ty.showSyntaxErrors": true,
  "ty.completions.autoImport": true,
  "ty.completions.completeFunctionParentheses": true,
  "ty.inlayHints.variableTypes": true,
  "ty.inlayHints.callArgumentNames": true,
  "editor.suggestOnTriggerCharacters": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.inlineSuggest.enabled": true,
  "editor.parameterHints.enabled": true,
  "editor.wordBasedSuggestions": "off",
  "jupyter.askForKernelRestart": false,
  "jupyter.kernels.excludePythonEnvironments": [],
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.widgetScriptSources": [
    "jsdelivr.com",
    "unpkg.com"
  ],
  "jupyter.interactiveWindow.creationMode": "perFile",
  "jupyter.enableExtendedPythonKernelCompletions": true,
  "jupyter.kernels.trusted": [
    "${workspaceFolder}/**/*.ipynb"
  ],
  "notebook.formatOnSave.enabled": true,
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "notebook.lineNumbers": "on",
  "notebook.output.textLineLimit": 40,
  "[jupyter-notebook]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "colab.logging.level": "info",
  "colab.uploading": true,
  "colab.activityBarContentView": true,
  "colab.activityBarResourceView": true,
  "colab.serverMounting": false,
  "colab.terminal": true,
  "colab.importNotebookFromUrl": true,
  "chatgpt.cliExecutable": "/usr/local/bin/codex",
  "chatgpt.openOnStartup": false,
  "chatgpt.followUpQueueMode": "queue",
  "chatgpt.composerEnterBehavior": "cmdIfMultiline",
  "chatgpt.reviewDelivery": "inline",
  "chatgpt.commentCodeLensEnabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.organizeImports": "explicit"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "evenBetterToml.formatter.alignEntries": false,
  "yaml.disableSchemaDetection": [],
  "redhat.telemetry.enabled": false,
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/target": true,
    "**/.hypothesis": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/target/**": true,
    "**/.git/objects/**": true
  },
  "workbench.editor.autoLockGroups": {
    "jupyter-notebook": true
  },
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./Agents",
    "-p",
    "*test.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "cursorpyright.disableLanguageServices": false,
  "cursorpyright.disableOrganizeImports": true,
  "cursorpyright.importStrategy": "fromEnvironment",
  "cursorpyright.analysis.typeCheckingMode": "off",
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "cursorpyright.analysis.autoSearchPaths": true,
  "cursorpyright.analysis.autoImportCompletions": true,
  "cursorpyright.analysis.useLibraryCodeForTypes": true,
  "cursorpyright.analysis.extraPaths": [
    "src",
    "WebSearch"
  ],
  "cursorpyright.analysis.inlayHints.variableTypes": true,
  "cursorpyright.analysis.inlayHints.functionReturnTypes": true,
  "cursorpyright.analysis.inlayHints.callArgumentNames": true,
  "[markdown]": {
    "editor.defaultFormatter": "davidanson.vscode-markdownlint",
    "editor.formatOnSave": true
  },
  "markdownlint.run": "onType",
  "markdownlint.configFile": ".markdownlint.jsonc",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
    "!**/.venv/**",
    "!**/node_modules/**",
    "!**/.git/**",
    "!**/docs/superpowers/**"
  ],
  "gitlens.currentLine.enabled": true,
  "gitlens.codeLens.enabled": true,
  "gitlens.hovers.enabled": true,
  "gitlens.statusBar.enabled": true,
  "gitlens.telemetry.enabled": false,
  "gitlens.ai.enabled": true,
  "dev.containers.copyGitConfig": true,
  "dev.containers.enableSSHAgentForwarding": true,
  "dev.containers.showReopenInContainerPrompt": true,
  "dev.containers.defaultExtensions": [
    "anysphere.cursorpyright",
    "anysphere.remote-containers",
    "ms-python.python",
    "charliermarsh.ruff",
    "davidanson.vscode-markdownlint",
    "eamodio.gitlens",
    "openai.chatgpt",
    "sourcegraph.cody-ai",
    "meta.pyrefly"
  ],
  "cody.codebase": "https://github.com/lulellis53-sudo/langgraph-swarm-sdk.git",
  "cody.suggestions.mode": "autocomplete",
  "cody.autocomplete.completeSuggestWidgetSelection": true,
  "cody.autocomplete.disableInsideComments": true,
  "cody.autocomplete.formatOnAccept": false,
  "cody.autocomplete.languages": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "json": false,
    "jsonc": false,
    "yaml": false
  },
  "cody.chat.defaultLocation": "sticky",
  "cody.chat.agenticContext": true,
  "cody.codeActions.enabled": true,
  "cody.commandCodeLenses": false,
  "cody.commandHints.enabled": true,
  "cody.rules.enabled": false
}
