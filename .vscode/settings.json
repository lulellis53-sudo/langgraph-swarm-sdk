{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.languageServer": "None",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.extraPaths": ["src"],
  "python.analysis.diagnosticMode": "off",
  "python.envFile": "${workspaceFolder}/.env",
  "python.createEnvironment.trigger": "off",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": ["Agents/benchmark", "-q"],
  "debugpy.debugJustMyCode": true,

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    },
    "editor.defaultFoldingRangeProvider": "charliermarsh.ruff"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    },
    "gitlens.codeLens.enabled": false,
    "gitlens.currentLine.enabled": false
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "[ipynb]": {
    "editor.formatOnSave": true,
    "gitlens.codeLens.enabled": false
  },

  "biome.enabled": true,
  "biome.requireConfiguration": true,
  "biome.suggestInstallingGlobally": false,

  "ruff.enable": true,
  "ruff.nativeServer": "on",
  "ruff.configuration": "pyproject.toml",
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.interpreter": ["${workspaceFolder}/.venv/bin/python"],
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.lint.run": "onSave",
  "ruff.showNotifications": "onError",
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],

  "ty.importStrategy": "fromEnvironment",
  "ty.interpreter": "${workspaceFolder}/.venv/bin/python",
  "ty.diagnosticMode": "workspace",
  "ty.experimental.useUv": "on",
  "ty.disableLanguageServices": false,
  "ty.showSyntaxErrors": true,
  "ty.completions.autoImport": true,
  "ty.completions.completeFunctionParentheses": true,
  "ty.inlayHints.variableTypes": true,
  "ty.inlayHints.callArgumentNames": true,

  "markdownlint.configFile": ".markdownlint.json",
  "markdownlint.run": "onSave",
  "markdownlint.focusMode": false,

  "editor.suggestOnTriggerCharacters": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.inlineSuggest.enabled": true,
  "editor.parameterHints.enabled": true,
  "editor.wordBasedSuggestions": "off",

  "jupyter.askForKernelRestart": false,
  "jupyter.allowUnauthorizedRemoteConnection": false,
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.interactiveWindow.creationMode": "perFile",
  "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"],
  "jupyter.kernels.excludePythonEnvironments": [],
  "jupyter.jupyterServerType": "local",
  "notebook.formatOnSave.enabled": true,
  "notebook.lineNumbers": "on",
  "notebook.output.scrolling": true,
  "notebook.output.textLineLimit": 80,
  "notebook.consolidatedOutputView": true,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "notebook.codeActionsOnSave": {
    "notebook.source.organizeImports": "explicit"
  },

  "colab.logging.level": "info",
  "colab.uploading": true,
  "colab.activityBarContentView": true,
  "colab.activityBarResourceView": true,
  "colab.serverMounting": false,
  "colab.terminal": true,
  "colab.importNotebookFromUrl": true,

  "docker.showStartPage": false,
  "docker.composeBuild": true,
  "docker.composeDetached": true,
  "docker.composeFile": "${workspaceFolder}/docker/compose.yaml",
  "docker.commands.composeUp": [
    {
      "label": "Compose Up: docker/compose.yaml",
      "template": "docker compose -f ${workspaceFolder}/docker/compose.yaml up -d --build"
    }
  ],
  "docker.commands.composeDown": [
    {
      "label": "Compose Down: docker/compose.yaml",
      "template": "docker compose -f ${workspaceFolder}/docker/compose.yaml down"
    }
  ],
  "containers.context": "default",
  "containers.composeCommand": "docker",
  "containers.containers.groupBy": "Compose Project Name",
  "containers.images.groupBy": "Repository",

  "dev.containers.copyGitConfig": true,
  "dev.containers.executeInWSL": false,
  "dev.containers.dockerPath": "docker",
  "dev.containers.dockerComposePath": "docker compose",
  "remote.containers.workspaceMountConsistency": "cached",

  "git.autofetch": true,
  "git.autofetchPeriod": 180,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.fetchOnPull": true,
  "git.openRepositoryInParentFolders": "always",
  "git.showPushSuccessNotification": true,
  "scm.defaultViewMode": "tree",

  "gitlens.ai.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.modelOptions.temperature": 0.2,
  "gitlens.ai.generateCommitMessage.customInstructions": "Follow Conventional Commits when it fits (feat|fix|docs|chore|refactor|test). Subject ≤72 chars; optional short body for why. Always end the full message with a blank line, then one trailer line: GitLens-Model: <provider:model> using the exact model id that produced the text (e.g. vscode:default or openai:gpt-4o). Never skip the trailer.",
  "gitlens.ai.generateCommits.customInstructions": "Same rules for every generated commit: Conventional Commits, concise why-focused wording, and each message must end with a blank line plus GitLens-Model: <provider:model> trailer for the model used.",

  "gitlens.telemetry.enabled": false,
  "gitlens.showWelcomeOnInstall": false,
  "gitlens.showWhatsNewAfterUpgrades": false,
  "gitlens.integrations.enabled": true,
  "gitlens.smartFormatting.enabled": true,
  "gitlens.defaultDateStyle": "relative",
  "gitlens.defaultDateSource": "committed",
  "gitlens.hovers.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.hovers.changes": true,
  "gitlens.hovers.avatars": true,
  "gitlens.hovers.pullRequests.enabled": true,
  "gitlens.hovers.autolinks.enabled": true,
  "gitlens.hovers.autolinks.enhanced": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.currentLine.scrollable": true,
  "gitlens.currentLine.pullRequests.enabled": true,
  "gitlens.currentLine.format": "${author, }${agoOrDate|14-} ${message|50?}",
  "gitlens.currentLine.uncommittedChangesFormat": "${author, }Uncommitted ${changes}",
  "gitlens.codeLens.enabled": true,
  "gitlens.codeLens.authors.enabled": true,
  "gitlens.codeLens.recentChange.enabled": true,
  "gitlens.codeLens.includeSingleLineSymbols": false,
  "gitlens.codeLens.scopes": ["document", "containers"],
  "gitlens.codeLens.recentChange.command": "gitlens.showQuickCommitFileDetails",
  "gitlens.codeLens.authors.command": "gitlens.showQuickFileHistory",
  "gitlens.statusBar.enabled": true,
  "gitlens.statusBar.alignment": "right",
  "gitlens.statusBar.format": "${author}, ${agoOrDate}",
  "gitlens.blame.compact": true,
  "gitlens.blame.format": "${author|12} ${agoOrDate|14-} ${message|50?}",
  "gitlens.blame.heatmap.enabled": false,
  "gitlens.blame.highlight.enabled": true,
  "gitlens.fileAnnotations.preserveWhileEditing": false,
  "gitlens.graph.layout": "editor",
  "gitlens.graph.onlyFollowFirstParent": false,
  "gitlens.views.repositories.includeWorkingTree": true,
  "gitlens.views.repositories.showBranches": true,
  "gitlens.views.repositories.showRemotes": true,
  "gitlens.views.repositories.showTags": true,
  "gitlens.views.repositories.showStashes": true,
  "gitlens.views.repositories.showUpstreamStatus": true,
  "gitlens.views.repositories.showIncomingActivity": false,
  "gitlens.views.worktrees.reveal": true,
  "gitlens.views.worktrees.pullRequests.enabled": true,
  "gitlens.views.worktrees.pullRequests.showForBranches": true,
  "gitlens.views.worktrees.files.layout": "tree",
  "gitlens.views.branches.branches.layout": "tree",
  "gitlens.views.commitDetails.files.layout": "tree",
  "gitlens.views.commitDetails.files.threshold": 80,
  "gitlens.launchpad.indicator.enabled": true,
  "gitlens.launchpad.indicator.polling.enabled": false,
  "gitlens.launchpad.indicator.openInEditor": true,
  "gitlens.launchpad.staleThreshold": 14,
  "gitlens.mode.statusBar.enabled": true,
  "gitlens.modes": {
    "review": {
      "name": "Review",
      "description": "Integration / PR review (heatmap + lenses)",
      "annotations": "heatmap",
      "codeLens": true,
      "currentLine": true,
      "hovers": true
    },
    "focus": {
      "name": "Focus",
      "description": "Line blame + hovers only",
      "annotations": false,
      "codeLens": false,
      "currentLine": true,
      "hovers": true
    }
  },
  "gitlens.terminalLinks.enabled": true,
  "gitlens.advanced.messages": {
    "suppressIntegrationRequestAlreadyInstalledWarning": true
  },

  "chatgpt.openOnStartup": false,
  "chatgpt.followUpQueueMode": "queue",
  "chatgpt.composerEnterBehavior": "cmdIfMultiline",
  "chatgpt.reviewDelivery": "inline",
  "chatgpt.commentCodeLensEnabled": true,

  "cursor.general.gitGraphIndexing": "enabled",

  "evenBetterToml.formatter.alignEntries": false,
  "yaml.disableSchemaDetection": [],
  "redhat.telemetry.enabled": false,

  "files.associations": {
    "AGENTS.md": "markdown",
    "agent.yaml": "yaml",
    "coordination.yaml": "yaml",
    "swarm.yaml": "yaml"
  },
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.hypothesis": true,
    "**/target": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/target/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/benchmark/results": true,
    "**/.remember": true
  },
  "workbench.editor.autoLockGroups": {
    "jupyter-notebook": true
  }
}
