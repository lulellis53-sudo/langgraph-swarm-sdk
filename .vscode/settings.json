{
  "markdownlint.run": "onType",
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": true
  },
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true
  },
  "gitlens.currentLine.pullRequests.enabled": false,
  "gitlens.statusBar.enabled": true,
  "gitlens.hovers.currentLine.over": "annotation",
  "gitlens.defaultDateStyle": "relative",
  "gitlens.blame.heatmap.enabled": false,
  "gitlens.launchpad.indicator.enabled": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
  "python-envs.workspaceSearchPaths": [
    ".pixi/envs/*"
  ],
  "python-envs.alwaysUseUv": true,
  "pyrefly.pyreflyExecutable": "bundled",
  "python.pyrefly.diagnosticMode": "openFilesOnly",
  "python.pyrefly.displayTypeErrors": "default",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  }
}
