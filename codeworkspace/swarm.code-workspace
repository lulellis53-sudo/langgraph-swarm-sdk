{
  "folders": [
    { "name": "SDK (integration)", "path": ".." },
    { "name": "Jupyter", "path": "../.Jupyter" },
    { "name": "Agents", "path": "../Agents" },
    { "name": "Main", "path": "../Main" },
    { "name": "Benchmark", "path": "../Agents/benchmark" },
    { "name": "WebSearch", "path": "../WebSearch" },
    { "name": "Prediction", "path": "../../Swarm-Prediction" },
    { "name": "Newsletter", "path": "../../Newsletter" }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:SDK (integration)}/.venv/bin/python",
    "python.testing.cwd": "${workspaceFolder:SDK (integration)}",
    "python.envFile": "${workspaceFolder:SDK (integration)}/.env",
    "ruff.interpreter": ["${workspaceFolder:SDK (integration)}/.venv/bin/python"],
    "ty.interpreter": "${workspaceFolder:SDK (integration)}/.venv/bin/python",
    "ty.diagnosticMode": "workspace",
    "ty.experimental.useUv": "on",
    "jupyter.notebookFileRoot": "${workspaceFolder:SDK (integration)}",
    "jupyter.askForKernelRestart": false,
    "jupyter.kernels.excludePythonEnvironments": [],
    "jupyter.jupyterServerType": "local",
    "notebook.formatOnSave.enabled": true,
    "notebook.lineNumbers": "on",
    "notebook.output.scrolling": true,
    "notebook.output.textLineLimit": 80,
    "jupyter.allowUnauthorizedRemoteConnection": false,
    "docker.composeFile": "${workspaceFolder:SDK (integration)}/docker/compose.yaml"
  }
}
