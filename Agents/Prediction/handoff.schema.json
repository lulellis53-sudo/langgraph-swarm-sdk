{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prediction handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "task_id", "status", "task"],
  "properties": {
    "agent": { "const": "Prediction" },
    "task_id": { "type": "string", "minLength": 1 },
    "task": { "const": "forecast_series" },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "horizon": { "type": "integer", "minimum": 1 },
    "frequency": { "type": "string", "minLength": 1 },
    "forecast_frame": { "type": ["string", "object"] },
    "model_settings": { "type": "object" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unique_id"],
        "properties": {
          "unique_id": { "type": ["string", "number", "integer"] },
          "mae": { "type": "number" },
          "rmse": { "type": "number" },
          "smape": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "results_path": { "type": "string", "minLength": 1 },
    "caveats": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "done" } } },
      "then": {
        "required": ["horizon", "frequency"],
        "anyOf": [{ "required": ["forecast_frame"] }, { "required": ["metrics"] }]
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["blocked", "needs_input"] } } },
      "then": { "required": ["notes"] }
    }
  ]
}
