{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewer handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "verdict", "findings"],
  "properties": {
    "agent": { "const": "Reviewer" },
    "task_id": { "enum": ["diff_review", "security_smell_check"] },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "verdict": { "enum": ["approve", "request_changes", "escalate"] },
    "findings": { "type": "array" }
  }
}
