{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Debugger handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "root_cause"],
  "properties": {
    "agent": { "const": "Debugger" },
    "task_id": { "enum": ["reproduce_failure", "identify_root_cause"] },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "root_cause": { "type": "string" },
    "reproduction_steps": { "type": "array", "items": { "type": "string" } },
    "fix_proposal": { "type": "string" }
  }
}
