{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "evidence_status"],
  "properties": {
    "agent": { "const": "RAG" },
    "task_id": { "enum": ["hybrid_retrieval", "semantic_caching"] },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "evidence_status": {
      "enum": ["supported", "partial", "conflicting", "not_found", "blocked"]
    },
    "passages": { "type": "array" },
    "cache_decision": { "enum": ["hit", "miss", "bypass", "n/a"] }
  }
}
