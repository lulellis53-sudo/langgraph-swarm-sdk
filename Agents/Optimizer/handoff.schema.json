{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimizer handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "bottleneck"],
  "properties": {
    "agent": { "const": "Optimizer" },
    "task_id": { "enum": ["profile_hotpath", "apply_optimization"] },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "bottleneck": { "type": "string" },
    "benchmark_delta": { "type": "object" }
  }
}
