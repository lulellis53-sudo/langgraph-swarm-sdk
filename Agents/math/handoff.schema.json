{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "math handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "verdict", "assumptions"],
  "properties": {
    "agent": { "const": "math" },
    "task_id": {
      "enum": ["solve_math", "verify_math", "numerical_stability_review", "verify_with_script"]
    },
    "task": {
      "enum": ["solve_math", "verify_math", "numerical_stability_review", "verify_with_script"]
    },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "backend": { "enum": ["sympy", "numpy", "pyarrow", "opencl", "molten", "llm", "n/a"] },
    "verdict": { "enum": ["proven", "refuted", "inconclusive", "n/a"] },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "checks": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "object" }
  }
}
