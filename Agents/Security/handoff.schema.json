{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "findings"],
  "properties": {
    "agent": { "const": "Security" },
    "task_id": { "enum": ["secrets_audit", "dependency_audit"] },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "findings": { "type": "array" },
    "dependency_vulnerabilities": { "type": "array" }
  }
}
