{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmarker handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["agent", "task_id", "status", "route", "workload"],
  "properties": {
    "agent": { "const": "Benchmarker" },
    "task_id": {
      "enum": [
        "define_workload",
        "measure_baseline",
        "compare_candidates",
        "author_suite",
        "regression_gate"
      ]
    },
    "status": { "enum": ["done", "blocked", "needs_input"] },
    "route": { "enum": ["L1", "L2", "L3", "L4"] },
    "workload": { "type": "string" },
    "baseline": { "type": "object" },
    "comparison": { "type": "array" },
    "published": { "type": "array" },
    "estimated": { "type": "array" },
    "gate_status": { "enum": ["pass", "fail", "not_run"] },
    "harness_paths": { "type": "array", "items": { "type": "string" } }
  }
}
