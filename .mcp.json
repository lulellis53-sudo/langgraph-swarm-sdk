    "context": {
      "type": "stdio",
      "command": "scripts/mcp-wrappers/context",
      "args": []
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com",
      "headers": {
        "Authorization": "Bearer ${APIFY_TOKEN}"
      }
    },
    "bright-data": {
      "type": "stdio",
      "command": "scripts/mcp-wrappers/brightdata",
      "args": []
    },
    "sentry": {
      "type": "stdio",
      "command": "/Users/usuario/.gemini/mcp/sentry",
      "args": [],
      "env": {
        "SENTRY_ORG": "dsadsadsa",
        "SENTRY_REGION_URL": "https://us.sentry.io"
      }
