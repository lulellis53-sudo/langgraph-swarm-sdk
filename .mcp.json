      // #list_local_env_files        P{ accountId, environmentId }
      // #create_environment          P{ accountId, environmentName }
      // #rename_environment          P{ accountId, environmentId, environmentName }
      // #authenticate                P{}
      // #mcp_auth                    P{}
      "command": "1password-mcp",
      "args": [],
      "type": "stdio"
    },
    "duckduckgo": {
      // spawn: npx duckduckgo-mcp-server | namespace: user-duckduckgo
      // #web_search — free; prefer before paid SERP when sufficient
      // #duckduckgo_web_search         P{ query, count?, safeSearch? }
      // #mcp_auth                      P{}
      "command": "npx",
      "args": ["-y", "duckduckgo-mcp-server"],
      "type": "stdio"
    },
    "jina": {
      // spawn: ~/.gemini/mcp/jina → npx jina-mcp-tools | namespace: user-jina
      // env: JINA_API_KEY (Keychain swarm/JINA_API_KEY; resolved by launcher)
      // #jina
      // #search_web                  P{ query }
      // #read_url                    P{ url }
      // #mcp_auth                    P{}
      "command": "/Users/usuario/.gemini/mcp/jina",
      "args": [],
      "type": "stdio"
    },
    "context7": {
      // spawn: https://mcp.context7.com/mcp | alt: npx @upstash/context7-mcp | namespace: user-context7
      // env: CONTEXT7_API_KEY (Bearer)
      // #docs — library/framework docs only (not general web search)
      // #resolve-library-id            P{ libraryName, query }
      // #query-docs                    P{ libraryId, query } — resolve-library-id first unless user gave /org/project
      // #mcp_auth                      P{}
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    },
    "deepwiki": {
      // spawn: npx deepwiki-mcp | fetches https://deepwiki.com/{owner}/{repo}
      // #deepwiki — OSS repo walkthrough docs (not a substitute for Context7 API docs)
      // #get-deepwiki-index          P{ owner, repo } — call before get-deepwiki-page
      // #get-deepwiki-page           P{ path } — path from index output
      // #mcp_auth                    P{}
      "command": "npx",
      "args": ["-y", "deepwiki-mcp"],
      "type": "stdio"
    },
    "Appwrite": {
      // spawn: npx mcp-remote https://mcp.appwrite.io/ | OAuth via console
      // namespace: user-Appwrite (same surface as appwrite-api when authenticated)
      // #appwrite
      // #appwrite_get_context          P{ project_id?, organization_id?, include_services?, service_detail?, sample_limit? }
