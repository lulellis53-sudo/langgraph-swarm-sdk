{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    },
    "context": {
      "type": "stdio",
      "command": "scripts/mcp-wrappers/context",
      "args": []
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com",
      "headers": {
        "Authorization": "Bearer ${APIFY_TOKEN}"
      }
    },
    "bright-data": {
      "type": "stdio",
      "command": "scripts/mcp-wrappers/brightdata",
      "args": []
    },
    "appwrite-api": {
      "type": "stdio",
      "command": "scripts/mcp-wrappers/appwrite-api",
      "args": []
    },
    "appwrite-docs": {
      "type": "stdio",
      "command": "scripts/mcp-wrappers/appwrite-docs",
      "args": []
    }
  }
}
