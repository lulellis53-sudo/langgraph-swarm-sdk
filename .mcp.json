// Hashtag routing: #git → GitKraken | #secrets → 1password | #web_search → duckduckgo | #jina → jina | #docs → context7 | #deepwiki → deepwiki | #appwrite → Appwrite*
// P{ } = MCP tool arguments. directory = absolute worktree (e.g. /Users/usuario/Myworkspace/Swarm).
{
  "mcpServers": {
