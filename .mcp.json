      // #appwrite_search_docs          P{ query, limit? }
      // #mcp_auth                      P{}
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.appwrite.io/"],
      "type": "stdio"
    },
    "appwrite-api": {
      // spawn: scripts/mcp-wrappers/appwrite-api | env: APPWRITE_API_KEY, APPWRITE_PROJECT_ID, APPWRITE_ENDPOINT
      // #appwrite
      // #appwrite_get_context          P{ project_id?, organization_id?, include_services?, service_detail?, sample_limit? }
      // #appwrite_search_tools         P{ query, service_hints?, argument_hints?, include_mutating?, limit? }
      // #appwrite_call_tool            P{ tool_name, arguments?, confirm_write?, project_id?, organization_id? }
      // #appwrite_search_docs          P{ query, limit? }
      // #mcp_auth                      P{}
      "type": "stdio",
      "command": "scripts/mcp-wrappers/appwrite-api",
      "args": []
