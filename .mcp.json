    "appwrite-docs": {
      // spawn: scripts/mcp-wrappers/appwrite-docs | namespace: plugin-appwrite-plugin-appwrite-docs
      // #docs (Appwrite)
      // #search                        P{ query }
      // #getDocsPage                   P{ path }
      // #listFeatures                  P{}
      // #getFeatureExamples            P{ feature }
      // #getTableOfContents            P{ path? }
      // #mcp_auth                      P{}
      "type": "stdio",
      "command": "scripts/mcp-wrappers/appwrite-docs",
      "args": []
