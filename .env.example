# Names only; never put values here. Store each key in the macOS Keychain:
#   uv run swarm-vault set <NAME>      (prompts for the value; encrypted by Keychain)
#   uv run swarm-vault status          (shows where each key resolves, never the value)
# Optional: pin every swarm agent and the router to one registered model route.
# Example: SWARM_MODEL=openai:gpt-4o-mini (uses OPENAI_API_KEY).
SWARM_MODEL=
MEM0_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
OPENAI_API_KEY=
JEV_API_KEY=
# Claude Code / Cursor MCP (.mcp.json, .cursor/mcp.json)
CONTEXT7_API_KEY=
CONTEXT_DEV_API_KEY=
APIFY_TOKEN=
APIFY_API_KEY=
BRIGHT_DATA_API_TOKEN=
BRIGHTDATA_MCP_TOKEN=
BRIGHT_DATA_UNLOCKER_ZONE=
BRIGHT_DATA_BROWSER_ZONE=
APPWRITE_API_KEY=
APPWRITE_PROJECT_ID=
APPWRITE_ENDPOINT=
# Sentry MCP (@sentry/mcp-server) + optional sentry-sdk — org dsadsadsa, see Main/config/sentry.yaml
SENTRY_ACCESS_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_REGION_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
