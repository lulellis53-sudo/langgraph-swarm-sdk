#!/bin/zsh
# 1Password -> Keychain. 1Password is the source of truth; the Keychain is the fast local copy the
# launcher reads (no 1Password prompt at every start).
#   sync-secrets            store secrets that are missing from the Keychain (never overwrites)
#   sync-secrets --check    list names whose Keychain value differs from 1Password (no changes)
#   sync-secrets --refresh  also overwrite Keychain values that differ (use after rotating a key)
# Source order: 1) the 1Password Environment mounted as a local .env (a named pipe, default ~/Desktop/.env,
# override WEBSCRAPER_OP_ENV_FILE; a plain-file .env is ignored on purpose), 2) the 1Password document
# Reads the 1Password document "txt" (override: WEBSCRAPER_OP_DOC), falling back to ".env", vault Personal.
# An archived document is still read (op document get --include-archive) when no active one matches.
# Values never reach argv or the terminal; only names are printed.
set -e
here="${0:A:h}"
source "$here/_secrets.zsh"
mode="${1:-missing}"
command -v op >/dev/null || { print "op CLI not installed" >&2; exit 1; }
vault="${WEBSCRAPER_OP_VAULT:-Personal}"
doc="${WEBSCRAPER_OP_DOC:-txt}"
text=""
envfile="${WEBSCRAPER_OP_ENV_FILE:-$HOME/Desktop/.env}"
if [ -p "$envfile" ]; then
  # 1Password serves the mount on demand; do not hang forever if it is not being served.
  text=$(perl -e 'alarm 15; exec @ARGV' cat "$envfile" 2>/dev/null) || text=""
  [ -n "$text" ] && print "source: 1Password Environment mount ($envfile)" >&2
fi
for d in "$doc" ".env"; do
  [ -n "$text" ] && break
  for flags in "" "--include-archive"; do
    text=$(op document get "$d" --vault "$vault" ${=flags} 2>/dev/null) && [ -n "$text" ] && break 2
    text=""
  done
done
[ -n "$text" ] || { print "cannot read 1Password document '$doc' (or '.env') in vault $vault, active or archived" >&2; exit 1; }
print -r -- "$text" | python3 -I -c '
import getpass, re, subprocess, sys
mode = sys.argv[1]; want = sys.argv[2:]; user = getpass.getuser()
doc = {}
for line in sys.stdin:
    m = re.match(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line.strip())
    if m: doc[m.group(1)] = m.group(2).strip().strip("\"\x27")
def kc(n):
    r = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", f"swarm/{n}", "-w"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None
def store(n, v, update):
    flag = "-U " if update else ""
    cmd = f"add-generic-password -s swarm/{n} -a {user} {flag}-X {v.encode().hex()}\n"
    return subprocess.run(["/usr/bin/security", "-i"], input=cmd, capture_output=True, text=True).returncode == 0
missing, differ, absent, ok = [], [], [], []
for n in want:
    v = doc.get(n)
    if not v: absent.append(n); continue
    cur = kc(n)
    (missing if cur is None else differ if cur != v else ok).append(n)
print(f"in sync: {len(ok)} | missing from Keychain: {missing or 0} | differs from 1Password: {differ or 0} | not in 1Password: {absent or 0}")
if mode == "--check": sys.exit(0)
done = [n for n in missing if store(n, doc[n], False)]
if mode == "--refresh": done += [n for n in differ if store(n, doc[n], True)]
print("stored/updated:", " ".join(done) or "none")' "$mode" "${WEBSCRAPER_SECRETS[@]}"
