{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": [
    "src"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "Agents/benchmark",
    "-q"
  ],
  "cursor.general.gitGraphIndexing": "enabled",
  "files.associations": {
    "AGENTS.md": "markdown",
    "agent.yaml": "yaml",
    "coordination.yaml": "yaml",
    "swarm.yaml": "yaml"
  },
  "search.exclude": {
    "**/.venv": true,
    "**/benchmark/results": true,
    "**/.remember": true
  },
  "codex.enabled": true,
  "codex.language": "python",
  "codex.framework": "langgraph",
  "codex.maxContext": 128000,
  "codex.temperature": 0.7,
  "codex.topP": 0.9,
  "codex.topK": 40,
  "codex.maxTokens": 4096,
  "codex.stopSequences": ["\n\n", "User:"],
  "codex.preferContext": true,
  "codex.enableCodeium": true,
  "codex.enableCopilot": true,
  "codex.enableAutocomplete": true,
  "codex.enableInlineSuggestions": true,
  "codex.enableMultiFileEdit": true,
  "codex.enableTestGeneration": true,
  "codex.enableRefactoring": true,
  "codex.enableDocumentation": true,
  "codex.enableOptimization": true,
  "codex.enableDebugging": true,
  "codex.enableReview": true,
  "codex.enableComments": true,
  "codex.enableTypeChecking": true,
  "codex.enableFormatting": true,
  "codex.enableImports": true,
  "codex.enableTesting": true,
  "codex.enableLinting": true,
  "codex.enableSecurity": true,
  "codex.enablePerformance": true,
  "codex.enableBestPractices": true,
  "codex.enableDocumentationGeneration": true,
  "codex.enableCodeCompletion": true,
  "codex.enableCodeExplanation": true,
  "codex.enableCodeTranslation": true,
  "codex.enableCodeSimplification": true,
  "codex.enableRefactoringSuggestions": true,
  "codex.enablePatternRecognition": true,
  "codex.enableArchitectureAnalysis": true,
  "codex.enableDependencyAnalysis": true,
  "codex.enableTestingStrategy": true,
  "codex.enablePerformanceAnalysis": true,
  "codex.enableSecurityAnalysis": true,
  "codex.enableBestPracticesRecommendation": true,
  "codex.enableDocumentationSuggestions": true,
  "codex.enableCodeReview": true,
  "codex.enableCodeImprovement": true,
  "codex.enableSuggestionsInComments": true,
  "codex.enableSuggestionsInStrings": false,
  "codex.enableSuggestionsInCode": true,
  "codex.enableSuggestionsInTests": true,
  "codex.enableSuggestionsInDocs": true,
  "codex.enableSuggestionsInConfigs": true,
  "codex.enableSuggestionsInScripts": true,
  "codex.enableSuggestionsInModels": true,
  "codex.enableSuggestionsInServices": true,
  "codex.enableSuggestionsInUtilities": true,
  "codex.enableSuggestionsInHelpers": true,
  "codex.enableSuggestionsInClients": true,
  "codex.enableSuggestionsInServers": true,
  "codex.enableSuggestionsInAgents": true,
  "codex.enableSuggestionsInOrchestrators": true,
  "codex.enableSuggestionsInWorkers": true,
  "codex.enableSuggestionsInPlans": true,
  "codex.enableSuggestionsInExecutors": true,
  "codex.enableSuggestionsInCaches": true,
  "codex.enableSuggestionsInMemories": true,
  "codex.enableSuggestionsInStores": true,
  "codex.enableSuggestionsInRouters": true,
  "codex.enableSuggestionsInEmbedders": true,
