{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["src"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "benchmark", "-q"],
  "cursor.general.gitGraphIndexing": "enabled",
  "files.associations": {
    "AGENTS.md": "markdown",
    "agent.yaml": "yaml",
    "coordination.yaml": "yaml",
    "swarm.yaml": "yaml"
  },
  "search.exclude": {
    "**/.venv": true,
    "**/benchmark/results": true,
    "**/.remember": true
  },
  "cody.codebase": "https://github.com/lulellis53-sudo/langgraph-swarm-sdk.git",
  "cody.suggestions.mode": "autocomplete",
  "cody.autocomplete.disableInsideComments": true,
  "cody.autocomplete.formatOnAccept": false,
  "cody.chat.defaultLocation": "sticky",
  "cody.chat.agenticContext": true,
  "cody.commandCodeLenses": false
}
